---
import Editor from "../components/Editor";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Milkdown + Hocuspocus prototype</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #f7f7f8;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      .milkdown-editor {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 1rem 1.5rem;
        min-height: 400px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Milkdown + Hocuspocus</h1>
      <p>Open this page in two tabs to see live collaboration.</p>
      <Editor client:only="react" />
    </main>
  </body>
</html>
